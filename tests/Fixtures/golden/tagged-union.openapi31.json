          },
          {
            "$ref": "#/components/schemas/ForwardedAttachment"
          },
          {
            "$ref": "#/components/schemas/ImageAttachment"
          },
          {
            "$ref": "#/components/schemas/LinkAttachment"
          }
        ],
        "discriminator": {
          "mapping": {
            "file": "#/components/schemas/FileAttachment",
            "forwarded": "#/components/schemas/ForwardedAttachment",
            "image": "#/components/schemas/ImageAttachment",
            "link": "#/components/schemas/LinkAttachment"
          },
          "propertyName": "kind"
        }
      },
      "AttachmentKind": {
        "type": "string",
        "enum": [
          "image",
          "link",
          "file",
          "forwarded"
        ],
        "x-enum-varnames": [
          "Image",
          "Link",
          "File",
          "Forwarded"
        ],
        "x-enumNames": [
          "Image",
          "Link",
          "File",
          "Forwarded"
        ]
      },
      "DraftAttachment": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/AttachmentKind"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "note"
        ]
      },
      "FileAttachment": {
        "type": "object",
        "properties": {
          "bytes": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "const": "file"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "bytes"
        ]
      },
      "ForwardedAttachment": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "const": "forwarded"
          },
          "original": {
            "$ref": "#/components/schemas/Attachment"
          }
        },
        "required": [
          "kind",
          "original",
          "from"
        ]
      },
      "ImageAttachment": {
        "type": "object",
        "properties": {
          "height": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "const": "image"
          },
          "url": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "url",
          "width",
          "height"
        ]
      },
      "LinkAttachment": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "const": "link"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "href"
        ]
      }
