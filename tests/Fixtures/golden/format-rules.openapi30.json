{
  "openapi": "3.0.4",
  "info": {
    "title": "API Documentation",
    "version": "1.0.0"
  },
  "paths": {
    "/api/zz-devices": {
      "post": {
        "operationId": "post.api.zz-devices",
        "tags": [
          "Device"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message",
                    "errors"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StoreDeviceRequest": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "format": "ip",
            "example": "192.0.2.1"
          },
          "colour": {
            "type": "string",
            "pattern": "^#(?:(?:[0-9a-fA-F]{3}){1,2}|(?:[0-9a-fA-F]{4}){1,2})\\n?$",
            "example": "#000000",
            "nullable": true
          },
          "gateway": {
            "type": "string",
            "format": "ipv4",
            "example": "192.0.2.1",
            "nullable": true
          },
          "ipv4": {
            "type": "string",
            "format": "ipv4",
            "example": "192.0.2.1"
          },
          "ipv6": {
            "type": "string",
            "format": "ipv6",
            "example": "2001:db8::1"
          },
          "mac": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5}|[0-9a-fA-F]{2}(?:-[0-9a-fA-F]{2}){5}|[0-9a-fA-F]{4}(?:\\.[0-9a-fA-F]{4}){2})$",
            "example": "00:00:5E:00:53:01"
          }
        },
        "required": [
          "address",
          "ipv4",
          "ipv6",
          "mac"
        ]
      }
    }
  }
}
