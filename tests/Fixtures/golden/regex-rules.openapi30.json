{
  "openapi": "3.0.4",
  "info": {
    "title": "API Documentation",
    "version": "1.0.0"
  },
  "paths": {
    "/api/zz-addresses": {
      "post": {
        "operationId": "post.api.zz-addresses",
        "tags": [
          "Address"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreAddressRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message",
                    "errors"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StoreAddressRequest": {
        "type": "object",
        "properties": {
          "colour": {
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}\\n?$",
            "nullable": true
          },
          "full_name": {
            "type": "string"
          },
          "initials": {
            "type": "string",
            "pattern": "^(?:[A-Za-z]|[^\\x00-\\x7F])+$",
            "example": "example"
          },
          "postcode": {
            "type": "string",
            "pattern": "^[A-Za-z]{1,2}[0-9][A-Z0-9a-z]? ?[0-9][A-Za-z]{2}$"
          },
          "recipient": {
            "type": "string",
            "pattern": "^(?:[A-Za-z\\t-\\r \\-]|[^\\x00-\\x7F])+$",
            "example": "example"
          },
          "unit": {
            "type": "string",
            "pattern": "^[a-zA-ZKſ]+$",
            "example": "example"
          }
        },
        "required": [
          "postcode",
          "unit",
          "recipient",
          "initials",
          "full_name"
        ]
      }
    }
  }
}
