{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "info": {
    "title": "API Documentation",
    "version": "1.0.0"
  },
  "paths": {
    "/api/zz-accounts": {
      "post": {
        "operationId": "post.api.zz-accounts",
        "tags": [
          "Account"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreAccountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message",
                    "errors"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StoreAccountRequest": {
        "type": "object",
        "properties": {
          "alias": {
            "description": "Must differ from username."
          },
          "handle": {
            "type": "string",
            "not": {
              "enum": [
                "admin",
                "root"
              ]
            }
          },
          "level": {
            "type": "integer",
            "not": {
              "enum": [
                1,
                2
              ]
            }
          },
          "nickname": {
            "description": "Must not match /^admin/."
          },
          "prefix": {
            "not": {
              "type": "string",
              "pattern": "^sys"
            }
          },
          "referrer": {
            "description": "Must not be sent when role is guest."
          },
          "role": {
            "not": {
              "enum": [
                "admin",
                "root"
              ]
            }
          },
          "suffix": {
            "not": {
              "type": "string",
              "pattern": "bot$"
            }
          },
          "tier": {
            "not": {
              "enum": [
                1,
                2
              ]
            }
          },
          "username": {
            "type": "string",
            "maxLength": 32,
            "example": "example"
          }
        },
        "required": [
          "username"
        ]
      }
    }
  }
}
