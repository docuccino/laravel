    "/api/attachments/{id}": {
      "get": {
        "summary": "A polymorphic morph (Widget|Gadget) → discriminated oneOf keyed by the morph map.",
        "tags": [
          "Integrations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Gadget"
                    },
                    {
                      "$ref": "#/components/schemas/Widget"
                    }
                  ],
                  "discriminator": {
                    "mapping": {
                      "gadget": "#/components/schemas/Gadget",
                      "widget": "#/components/schemas/Widget"
                    },
                    "propertyName": "type"
                  }
                }
              }
            }
          }
        }
      }
    },
