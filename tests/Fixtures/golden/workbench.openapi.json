  "components": {
    "schemas": {
      "Article": {
        "type": "object",
        "properties": {
          "author": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AuthorData"
              },
              {
                "type": "null"
              }
            ]
          },
          "body": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "subtitle": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "headline",
          "body",
          "author"
        ]
      },
      "ArticleJsonApiResource": {
        "type": "object",
        "properties": {
          "attributes": {
            "type": "object",
            "properties": {
              "body": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "body"
            ]
          },
          "id": {
            "type": "string"
          },
          "links": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "href": {
                  "type": "string"
                },
                "meta": {
                  "type": "object"
                }
              },
              "required": [
                "href"
              ]
            }
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      "ArticleRequest": {
        "type": "object",
        "properties": {
          "author": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "email"
            ]
          },
          "body": {
            "type": "string",
            "maxLength": 500
          },
          "heading": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "internal": {
            "type": "integer"
          },
          "secret": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
