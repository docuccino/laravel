    "/api/checkout": {
      "post": {
        "summary": "Throws a renderable exception whose render() defines a 402 — documented by the inferred tier.",
        "tags": [
          "Integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "const": 402
                    },
                    "title": {
                      "type": "string",
                      "const": "Payment Required"
                    },
                    "type": {
                      "type": "string",
                      "const": "https://example.test/problems/payment-required"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status"
                  ]
                },
                "example": {
                  "type": "https://example.test/problems/payment-required",
                  "title": "Payment Required",
                  "status": 402
                }
              }
            }
          }
        }
      }
    },
