{
    "name": "docuccino/laravel",
    "description": "Laravel adapter for Docuccino: route discovery, extension registry, pipeline and artisan export.",
    "type": "library",
    "keywords": [
        "openapi",
        "api-documentation",
        "laravel",
        "uir",
        "swagger",
        "scramble-alternative"
    ],
    "homepage": "https://docuccino.app",
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Martin"
        }
    ],
    "support": {
        "issues": "https://github.com/docuccino/docuccino/issues",
        "source": "https://github.com/docuccino/docuccino"
    },
    "require": {
        "php": "^8.3",
        "docuccino/core": "self.version",
        "docuccino/attributes": "self.version",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/process": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "docuccino/inference-phpstan": "self.version",
        "illuminate/testing": "^12.0 || ^13.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "lorisleiva/laravel-actions": "^2.0",
        "pestphp/pest": "^4.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-json-api-paginate": "^2.0",
        "timacdonald/json-api": "^1.0@beta"
    },
    "suggest": {
        "illuminate/testing": "Required by the contract-testing helpers (Docuccino\\Laravel\\Testing) — every Laravel application already has it through laravel/framework.",
        "phpunit/phpunit": "Required by the contract-testing helpers (Docuccino\\Laravel\\Testing), which are only ever loaded from a test suite.",
        "docuccino/inference-phpstan": "Required for static type inference — install as a dev dependency: composer require --dev docuccino/inference-phpstan. Without it documentation comes from docblocks and attributes only."
    },
    "autoload": {
        "psr-4": {
            "Docuccino\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Docuccino\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Docuccino\\Laravel\\DocuccinoServiceProvider"
            ],
            "aliases": {
                "Docuccino": "Docuccino\\Laravel\\Facades\\Docuccino"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
